{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ow2rg/ow2-eu-region-guard/data/servers.schema.json",
  "title": "OW2 EU Region Guard server catalog",
  "description": "Documentation of the catalog format. The app enforces this (and more: CIDR canonical form, special-range rejection, provenance, conflicts, hostile text) in CatalogValidator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "generatedAtUtc", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "generator": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "url": { "type": "string", "pattern": "^https://" },
          "retrievedAtUtc": { "type": "string", "format": "date-time" },
          "publisherTimestamp": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "prefixCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "region", "cidrs", "confidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "datacenterCode": { "type": "string", "pattern": "^[A-Z0-9]{2,8}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "region": { "enum": ["EU", "ME", "NA", "AS", "OC", "SA", "UNKNOWN"] },
          "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "hosting": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider"],
            "properties": {
              "provider": { "enum": ["aws", "google-cloud", "blizzard", "other", "unknown"] },
              "providerRegions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" } }
            }
          },
          "cidrs": {
            "type": "array",
            "maxItems": 20000,
            "description": "Canonical CIDRs only (no host bits). IPv4 /8 or narrower, IPv6 /16 or narrower. Special-purpose space is rejected.",
            "items": { "type": "string", "maxLength": 64 }
          },
          "confidence": { "enum": ["observed", "corroborated", "community", "unverified"] },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "kind"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://" },
                "kind": { "enum": ["official-provider-feed", "community-list", "netgraph-observation", "registry-whois", "other"] },
                "retrievedAtUtc": { "type": "string", "format": "date-time" },
                "note": { "type": "string", "maxLength": 500 }
              }
            }
          },
          "lastVerifiedAtUtc": { "type": "string", "format": "date-time" },
          "observedAtUtc": { "type": "string", "format": "date-time" },
          "acquisitionMethod": { "type": "string", "maxLength": 120 },
          "excludeFromBlocking": { "type": "boolean", "description": "Never auto-block, even if the region is targeted (e.g. Blizzard-owned networks)." },
          "exclusionReason": { "type": "string", "maxLength": 500 },
          "protectOnly": { "type": "boolean", "description": "Safety-net entry: only subtracts addresses, describes no datacenter." },
          "enabled": { "type": "boolean", "default": true },
          "notes": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
