<Window x:Class="OW2RG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OW2 EU Region Guard" Width="1200" Height="860" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14"
        Icon="Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Image Source="Assets/app.ico" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding L[AppTitle]}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding L[AppSubtitle]}" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="16" Padding="12,6" Margin="0,0,12,0" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="active">
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="partial">
                                        <Setter Property="Background" Value="{StaticResource WarningSoft}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                        <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Muted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="active"><Setter Property="Fill" Value="{StaticResource Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="partial"><Setter Property="Fill" Value="{StaticResource Warning}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="error"><Setter Property="Fill" Value="{StaticResource Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Body ================= -->
        <TabControl Grid.Row="1" Margin="16,8,16,0">
            <!-- ======== Dashboard ======== -->
            <TabItem Header="{Binding L[TabDashboard]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" MinWidth="300"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left column: environment -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[CardGame]}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding GamePath}" Style="{StaticResource Mono}" FontSize="12.5" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding GameSourceText}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource AutoHide}" Text="{Binding GameProblems}" Foreground="{StaticResource Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Border Background="{StaticResource WarningSoft}" CornerRadius="6" Padding="8" Margin="0,8,0,0"
                                            Visibility="{Binding GameRunning, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding L[GameRunning]}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Warning}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding L[Browse]}" Command="{Binding BrowseCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                                        <Button Content="{Binding L[Detect]}" Command="{Binding DetectCommand}" Style="{StaticResource GhostButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[CardFirewall]}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding FirewallText}" TextWrapping="Wrap" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FirewallOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AdminText}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[CardCatalog]}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding CatalogLine}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CatalogQuality}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource AutoHide}" Text="{Binding CatalogNotes}" Foreground="{StaticResource Warning}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <CheckBox IsChecked="{Binding AllowCommunity}" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding L[AllowCommunity]}" TextWrapping="Wrap" FontSize="12.5"/>
                                    </CheckBox>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="{Binding L[RefreshFeeds]}" Command="{Binding RefreshFeedsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding L[UseBundled]}" Command="{Binding UseBundledCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right column: decision -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[DesiredBehavior]}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <RadioButton Style="{StaticResource ProfileCard}" IsChecked="{Binding IsMeSelected}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding L[ProfMeTitle]}" FontSize="15.5" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}">
                                                    <TextBlock Text="{Binding L[ProfMeBadge]}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding L[ProfMeDesc]}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton Style="{StaticResource ProfileCard}" IsChecked="{Binding IsEuSelected}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding L[ProfEuTitle]}" FontSize="15.5" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}">
                                                    <TextBlock Text="{Binding L[ProfEuBadge]}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Warning}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding L[ProfEuDesc]}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton Style="{StaticResource ProfileCard}" IsChecked="{Binding IsDefaultSelected}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding L[ProfDefaultTitle]}" FontSize="15.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding L[ProfDefaultDesc]}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{Binding L[Preview]}" Command="{Binding PreviewCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                        <Button Content="{Binding L[Apply]}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Padding="22,9"/>
                                        <Button Content="{Binding L[Refresh]}" Command="{Binding RefreshCommand}" Style="{StaticResource LinkButton}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live status vs. verification: deliberately two different lines -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource AutoHide}" Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                                    <ItemsControl ItemsSource="{Binding StatusProblems}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12.5"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource AutoHide}" Text="{Binding VerificationText}" Foreground="{StaticResource Brand}" TextWrapping="Wrap" FontSize="12.5" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Result of the last action -->
                            <Border CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultKind}" Value="none"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ResultKind}" Value="ok"><Setter Property="Background" Value="{StaticResource SuccessSoft}"/><Setter Property="BorderBrush" Value="{StaticResource Success}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ResultKind}" Value="warn"><Setter Property="Background" Value="{StaticResource WarningSoft}"/><Setter Property="BorderBrush" Value="{StaticResource Warning}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ResultKind}" Value="error"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="BorderBrush" Value="{StaticResource Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding L[ResultTitle]}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <Expander Header="Details" Foreground="{StaticResource Muted}" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding ResultSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" Margin="0,1"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Preview -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L[PreviewTitle]}" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewKind}" Value="error"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource AutoHide}" Text="{Binding DryText}" Foreground="{StaticResource Success}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <ItemsControl ItemsSource="{Binding PreviewWarnings}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="12.5"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding PreviewRows}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="68"/>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="block"><Setter Property="Background" Value="{StaticResource DangerSoft}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="keep"><Setter Property="Background" Value="{StaticResource SuccessSoft}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Mark}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Region}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander Header="Exact firewall rules" Foreground="{StaticResource Muted}" Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding PreviewRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,3" BorderThickness="0"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ======== Catalog ======== -->
            <TabItem Header="{Binding L[TabCatalog]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,8">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding CatalogLine}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding L[CatalogExplain]}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding CatalogRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                        <StackPanel FlowDirection="LeftToRight">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Region}" FontWeight="Bold" Foreground="{StaticResource Brand}" Width="44"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Confidence}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="44,2,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Ranges, Mode=OneWay}"/><Run Text=" range(s) · verified "/><Run Text="{Binding Verified, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Use}" FontSize="12.5" Margin="44,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Notes}" Foreground="{StaticResource Muted}" FontSize="12" Margin="44,2,0,0" TextWrapping="Wrap"/>
                                            <Expander Header="Sources" Foreground="{StaticResource Muted}" Margin="40,4,0,0">
                                                <TextBox Text="{Binding Sources, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11.5" BorderThickness="0"/>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== Verify ======== -->
            <TabItem Header="{Binding L[TabVerify]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,8">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding L[VerifyTitle]}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding L[VerifyStep1]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[VerifyStep2]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[VerifyStep3]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[VerifyStep4]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[VerifyStep5]}" TextWrapping="Wrap" Margin="0,2" Foreground="{StaticResource Warning}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,12,8" Width="150">
                                        <TextBlock Text="{Binding L[VerifyCode]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding VerifyCode, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="8"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="200">
                                        <TextBlock Text="{Binding L[VerifyIp]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding VerifyIp, UpdateSourceTrigger=PropertyChanged}" MaxLength="45"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="130">
                                        <TextBlock Text="{Binding L[VerifyPing]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding VerifyPing, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="150">
                                        <TextBlock Text="{Binding L[VerifyMode]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding VerifyMode}"/>
                                    </StackPanel>
                                    <CheckBox Content="{Binding L[VerifyParty]}" IsChecked="{Binding VerifyParty}" VerticalAlignment="Bottom" Margin="0,0,12,14"/>
                                </WrapPanel>
                                <Button Content="{Binding L[VerifySave]}" Command="{Binding SaveObservationCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding L[VerifyManual]}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding ObservationSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <ItemsControl ItemsSource="{Binding Observations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Mono}" Margin="0,2">
                                            <Run Text="{Binding When, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Code, Mode=OneWay}" FontWeight="Bold"/><Run Text="   "/><Run Text="{Binding Region, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Party, Mode=OneWay}"/><Run Text="   ping "/><Run Text="{Binding Ping, Mode=OneWay}"/><Run Text="   profile "/><Run Text="{Binding Profile, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== Diagnostics ======== -->
            <TabItem Header="{Binding L[TabDiagnostics]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,8">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="{Binding L[DiagOffline]}" Command="{Binding OfflineCheckCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding L[DiagLive]}" Command="{Binding LiveSelfTestCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding L[DiagExport]}" Command="{Binding ExportCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding L[DiagFolder]}" Command="{Binding OpenFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                    <Button Content="{Binding L[Copy]}" Command="{Binding CopyRecoveryCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding L[DiagLiveExplain]}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding DiagLines}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,1"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding L[DiagActivity]}" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding AuditLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======== Help ======== -->
            <TabItem Header="{Binding L[TabHelp]}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,8">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding L[HelpTitle]}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding L[Help1]}" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding L[Help2]}" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding L[Help3]}" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding L[Help4]}" TextWrapping="Wrap" Margin="0,4"/>
                                <TextBlock Text="{Binding L[HelpNoTricks]}" TextWrapping="Wrap" Margin="0,4" Foreground="{StaticResource Success}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Warning}">
                            <StackPanel>
                                <TextBlock Text="{Binding L[HelpRisks]}" Style="{StaticResource CardTitle}" Foreground="{StaticResource Warning}"/>
                                <TextBlock Text="{Binding L[ConfirmRisk1]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[ConfirmRisk2]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[ConfirmRisk3]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[ConfirmRisk4]}" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="{Binding L[ConfirmRisk5]}" TextWrapping="Wrap" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= Always-visible restore bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding L[Restore]}" Command="{Binding RestoreCommand}" Style="{StaticResource RestoreButton}"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding L[RiskShort]}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" Margin="0,4,0,0">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" Foreground="{StaticResource Brand}" Background="{StaticResource Surface2}" BorderThickness="0" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Brand}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
