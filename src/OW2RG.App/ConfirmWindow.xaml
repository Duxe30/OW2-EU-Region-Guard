<Window x:Class="OW2RG.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False">
    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
            <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="14" x:Name="LinesBorder">
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LinesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <CheckBox x:Name="Ack" Margin="0,16,0,0" Foreground="{StaticResource Text}" Checked="AckChanged" Unchecked="AckChanged">
                <TextBlock x:Name="AckText" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </CheckBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="0,0,10,0" IsCancel="True" Click="CancelClick"/>
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Click="OkClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
